# Copy to .env.local for local development, or set these in the Vercel project's Environment Variables.
# Everything starting with VITE_ is built into the page and delivered to every visitor's browser,
# so NEVER put a secret here (no backend API_KEY, no Supabase service role / secret key).

# Backend address. Leave unset locally (Vite's dev server proxies /api to localhost:8000).
# On Vercel: your Render backend, e.g. https://your-backend.onrender.com   (the /api part is added if missing)
# VITE_API_BASE_URL=

# The app's key: the SAME value as APP_API_KEY on the backend. It tells the backend "this request comes
# from the app". It is not a secret (anyone who opens the app can read it) and opens nothing without a
# signed in person. It must be DIFFERENT from the backend's secret API_KEY (the scheduled NACTA upload).
VITE_API_KEY=

# Supabase project (sign in). Both values are public by design.
VITE_SUPABASE_URL=https://qtghepgrcksmkxrzydjc.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_beQz5ovScfxsLcD6GetDcA_8Ic8rIV6
